<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net35</TargetFramework>
        <AssemblyName>Hunie Pop Archipelago Client</AssemblyName>
        <Description>Archipelago Client for HuniePop</Description>
        <Version>2.0.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <!-- you may need this for getting the multiclient dll to output for .net 6 and netstandard 2.0 -->
        <!--        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>-->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <RootNamespace>HuniePopArchipelagoClient</RootNamespace>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>C:\huniepop\BepInEx\plugins\$(AssemblyName)</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\$(AssemblyName)</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
    </PropertyGroup>

    <Target Name="ZipMod" AfterTargets="PostBuildEvent" Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <ZipDirectory SourceDirectory="bin\Release\$(AssemblyName)" DestinationFile="bin\Release\$(AssemblyName)-$(Version).zip" Overwrite="true" />
    </Target>

    <!--AUTOMATIC BUILDING OF ZIP FILES SO THAT I DONT FORGET THE C-WSPP-WEBSOCKET-SHARP OVERWRITE-->
	<Target Name="CreateZip" AfterTargets="PostBuildEvent" Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<Copy SourceFiles="C:\huniepop\BepInEx\plugins\Hunie Pop Archipelago Client\Archipelago.MultiClient.Net.dll" DestinationFolder="C:\HuniePop\Hunie Pop Archipelago plugin WINDOWS\BepInEx\plugins\Hunie Pop Archipelago Client"/>
		<Copy SourceFiles="C:\huniepop\BepInEx\plugins\Hunie Pop Archipelago Client\Hunie Pop Archipelago Client.dll" DestinationFolder="C:\HuniePop\Hunie Pop Archipelago plugin WINDOWS\BepInEx\plugins\Hunie Pop Archipelago Client"/>
		<Copy SourceFiles="C:\huniepop\BepInEx\plugins\Hunie Pop Archipelago Client\Newtonsoft.Json.dll" DestinationFolder="C:\HuniePop\Hunie Pop Archipelago plugin WINDOWS\BepInEx\plugins\Hunie Pop Archipelago Client"/>
		<!--TODO: ADD DISTCTION FOR WINDOWS AND LINUX ONCE THEY ARE BOTH BEING BUILT-->
		<ZipDirectory SourceDirectory="C:\HuniePop\Hunie Pop Archipelago plugin WINDOWS" DestinationFile="C:\HuniePop\Hunie Pop Archipelago plugin vNEW.zip" Overwrite="true" />
	</Target>

    <ItemGroup>
        <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
		<PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
		<PackageReference Include="BepInEx.Core" Version="5.4.21" />
		<PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
		<PackageReference Include="UnityEngine.Modules" Version="4.2.2" IncludeAssets="compile" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    </ItemGroup>


	<ItemGroup>
		<!-- found in the \HuniePop 2 - Double Date_Data\Managed folder-->
		<!-- NOTE REMOVE THESE FILES IN OUTPUT BEFORE RLEASE -->
		<Reference Include="Assembly-CSharp">
			<HintPath>Libs\Assembly-CSharp.dll</HintPath>
		</Reference>
	</ItemGroup>

</Project>
